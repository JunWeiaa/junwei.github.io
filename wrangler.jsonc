{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "junwei-homepage",
    "compatibility_date": "2026-03-18",
    "main": "worker/index.mjs",
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": false
        }
    },
    "assets": {
        "directory": "_site",
        "binding": "ASSETS",
        "run_worker_first": [
            "/api/visit",
            "/analytics*"
        ]
    },
    "build": {
        "command": "LANG=C.UTF-8 LC_ALL=C.UTF-8 bundle exec jekyll build"
    },
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "vars": {
        "ACCOUNT_ID": "2cbb8090b52df4bda14c21d9ae74b8cb",
        "ACCESS_TEAM_DOMAIN": "junn-wei-hz.cloudflareaccess.com",
        "ACCESS_AUD": "ecd5a94f550d10d46af8c30658461844719f6880ac5ac0ef1468b9a29673e8f4"
    },
    "analytics_engine_datasets": [
        {
            "binding": "VISITS",
            "dataset": "website_visits"
        }
    ]
}
