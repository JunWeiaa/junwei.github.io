{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "junwei-homepage",
    "compatibility_date": "2026-03-18",
    "observability": {
        "enabled": true
    },
    "assets": {
        "directory": "_site"
    },
    "build": {
        "command": "LANG=C.UTF-8 LC_ALL=C.UTF-8 bundle exec jekyll build"
    },
    "compatibility_flags": [
        "nodejs_compat"
    ]
}